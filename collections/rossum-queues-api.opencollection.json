{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rossum REST Annotations Queues API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Queues",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List queues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.elis.rossum.ai/v1/queues",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List queues"
        },
        {
          "info": {
            "name": "Export extracted data from a queue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.elis.rossum.ai/v1/queues/:id/export",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "format",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Export extracted data from a queue"
        }
      ]
    }
  ],
  "bundled": true
}